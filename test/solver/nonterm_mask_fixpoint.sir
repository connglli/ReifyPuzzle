// EXPECT: PASS
// SKIP: INTERPRETER
// SOLVER_ARGS: --main @main --path '^entry,^h,^h' --require-nonterm

// Masking fixed point: %v & %?m == %v requires %?m to carry every set
// bit of %v (= 5), a non-trivial constraint the solver must satisfy
// (e.g. %?m = -1).
fun @main() : i32 {
  sym %?m : value i32;
  sym %?g : value i32;
  let mut %v : i32 = 5;
^entry:
  br ^h;
^h:
  %v = %?m & %v;
  br %?g > 0, ^h, ^exit;
^exit:
  ret %v;
}
