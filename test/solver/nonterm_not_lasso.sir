// EXPECT: FAIL
// SOLVER_ARGS: --main @main --path '^entry,^h' --require-nonterm

// The path's final block ^h is visited only once, so there is no cycle to
// certify divergence. RequireNonterm reports UNSAT rather than
// mis-certifying a straight-line prefix as non-terminating.
fun @main() : i32 {
  sym %?g : value i32;
  let mut %v : i32 = 0;
^entry:
  br ^h;
^h:
  %v = %?g ^ %v;
  br %?g > 0, ^h, ^exit;
^exit:
  ret %v;
}
