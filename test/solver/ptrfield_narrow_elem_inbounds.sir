// EXPECT: PASS
// SOLVER_ARGS: --main @main --path '^entry'

// The other direction of the same size-model bug: a *narrow* pointee inside a
// *wide* object. sizeof(@S) = 2 + 8 = 10 bytes and sizeof([2] i8) = 2, so
// `%p + 4` lands at byte 8 — comfortably inside. Counting one unit per scalar
// leaf makes the object 3 units while the stride stays 2, so the offset looks
// like 8 > 3 and the solver rejects a perfectly valid program. Under-counting
// costs soundness; over-counting costs completeness, and a byte-accurate model
// is what fixes both at once.
struct @S {
  f0: [2] i8;
  f1: i64;
}

fun @main() : i32 {
  let mut %t: @S = {{1, 2}, 9};
  let mut %ap: ptr @S = null;
  let mut %p: ptr [2] i8 = null;
^entry:
  %ap = addr %t;
  %p = ptrfield %ap, f0;
  %p = %p + 4;
  ret 0;
}
