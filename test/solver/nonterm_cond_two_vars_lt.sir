// EXPECT: PASS
// SKIP: INTERPRETER
// SOLVER_ARGS: --main @main --path '^entry,^h,^h' --require-nonterm

// The loop-continue condition compares two mutable variables: br %v < %w.
// Both recur non-trivially -- %v via an OR fixed point (%?p's bits must lie
// within %v = 6), %w via an AND fixed point (%?q must cover %w = 15) -- and
// the data-dependent guard 6 < 15 holds on the recurrent state every lap.
fun @main() : i32 {
  sym %?p : value i32;
  sym %?q : value i32;
  let mut %v : i32 = 6;
  let mut %w : i32 = 15;
^entry:
  br ^h;
^h:
  %v = %?p | %v;
  %w = %?q & %w;
  br %v < %w, ^h, ^exit;
^exit:
  ret %v;
}
