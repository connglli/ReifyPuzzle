// EXPECT: PASS
// SKIP: INTERPRETER
// SOLVER_ARGS: --main @main --path '^entry,^h,^h,^h' --require-nonterm

// A genuine period-2 lasso: %v alternates 7 -> -7 -> 7, so the header state
// recurs after exactly two laps and never after one. The path carries the
// period -- three arrivals at ^h means two laps -- so no extra flag is
// needed to ask for it. Compare nonterm_period1_on_period2_path, which is
// this same shape with a lap that recurs immediately.
fun @main() : i32 {
  sym %?g : value i32;
  let mut %v : i32 = 7;
^entry:
  br ^h;
^h:
  %v = 0 - %v;
  br %?g > 0, ^h, ^exit;
^exit:
  ret %v;
}
