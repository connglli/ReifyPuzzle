// EXPECT: FAIL:UndefinedBehavior
// SKIP: COMPILER  — @reduce_* backend lowering is planned (v0.2.3 V1); core only for now
// SPEC v0.2.3 §12.4 — @reduce_add over iN carries the ordinary scalar
// overflow UB (rule 4) at every intermediate step.  Folding {60,60,60,-100}
// as i8 left-to-right: 60+60=120 (ok), 120+60=180 overflows i8 (>127) → UB.
intrinsic @reduce_add(%v: <4> i8) : i8;

fun @main() : i32 {
  let %v: <4> i8 = {60, 60, 60, -100};
  let mut %r: i8 = 0;
^entry:
  %r = call @reduce_add(%v);   // UB at the second fold step
  ret 0;
}
