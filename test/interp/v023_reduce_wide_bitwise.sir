// EXPECT: PASS
// SPEC v0.2.3 §12.4 (V1) — bitwise reductions over a wider (N=8) integer
// vector; exercises a lane count other than 4.
intrinsic @reduce_and(%v: <8> i16) : i16;
intrinsic @reduce_or(%v: <8> i16) : i16;
intrinsic @reduce_xor(%v: <8> i16) : i16;

fun @main() : i32 {
  let %v: <8> i16 = {1, 2, 3, 4, 5, 6, 7, 8};
^entry:
  require call @reduce_and(%v) == 0,  "and 1..8 = 0";
  require call @reduce_or(%v)  == 15, "or 1..8 = 15";
  require call @reduce_xor(%v) == 8,  "xor 1..8 = 8";
  ret 0;
}
